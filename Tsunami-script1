-- Toggle creator
local function createToggle(yPos, text, callback, state)
    local ToggleFrame = Instance.new("Frame")
    ToggleFrame.Size = UDim2.new(1, 0, 0, 50)
    ToggleFrame.Position = UDim2.new(0, 0, 0, yPos)
    ToggleFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    ToggleFrame.Parent = Content
    local TCorner = Instance.new("UICorner")
    TCorner.CornerRadius = UDim.new(0, 8)
    TCorner.Parent = ToggleFrame

    local TLabel = Instance.new("TextLabel")
    TLabel.Size = UDim2.new(1, -80, 1, 0)
    TLabel.BackgroundTransparency = 1
    TLabel.Text = text
    TLabel.TextColor3 = Color3.new(1, 1, 1)
    TLabel.Font = Enum.Font.GothamSemibold
    TLabel.TextSize = 16
    TLabel.TextXAlignment = Enum.TextXAlignment.Left
    TLabel.Parent = ToggleFrame

    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(0, 60, 0, 30)
    ToggleBtn.Position = UDim2.new(1, -70, 0.5, -15)
    ToggleBtn.Text = state and "ON" or "OFF"
    ToggleBtn.BackgroundColor3 = state and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    ToggleBtn.TextColor3 = Color3.new(1, 1, 1)
    ToggleBtn.Font = Enum.Font.GothamBold
    ToggleBtn.TextSize = 14
    ToggleBtn.Parent = ToggleFrame
    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = ToggleBtn

    ToggleBtn.MouseButton1Click:Connect(function()
        state = not state
        ToggleBtn.Text = state and "ON" or "OFF"
        ToggleBtn.BackgroundColor3 = state and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
        callback(state)
    end)

    return state
end

-- Estados
local noTsunami = false
local speedEnabled = false

-- Targets tsunami
local targetNames = {"TsunamiEnd", "TsunamiStart", "FrontendLoader", "Tsunamis", "TypedRemote", "SpawnTsunami"}

local tsunamiConnection
local function toggleNoTsunami(enabled)
    noTsunami = enabled
    if enabled then
        for _, obj in ipairs(game:GetDescendants()) do
            if table.find(targetNames, obj.Name) then
                pcall(obj.Destroy, obj)
            end
        end
        tsunamiConnection = game.DescendantAdded:Connect(function(obj)
            if table.find(targetNames, obj.Name) then
                pcall(obj.Destroy, obj)
            end
        end)
    else
        if tsunamiConnection then tsunamiConnection:Disconnect() end
    end
end

local speedConnection
local function toggleSpeed(enabled)
    speedEnabled = enabled
    local char = Player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = enabled and 350 or 16
        end
    end
    if enabled then
        speedConnection = RunService.Heartbeat:Connect(function()
            local char = Player.Character
            if char and speedEnabled then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum.WalkSpeed = 350 end
            end
        end)
    else
        if speedConnection then speedConnection:Disconnect() end
    end
end

-- Toggles
createToggle(10, "🚫 Eliminar Tsunamis (Todo el juego)", toggleNoTsunami, false)
createToggle(70, "⚡ Velocidad 350 (Solo caminar)", toggleSpeed, false)

-- Toggle con L
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.L then
        ScreenGui.Enabled = not ScreenGui.Enabled
    end
end)

-- Draggable mejorado (soporte touch/mouse)
local dragging = false
local dragInput = nil
local dragStart = nil
local startPos = nil

Frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Frame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

RunService.RenderStepped:Connect(function()
    if dragging and dragInput then
        local delta = dragInput.Position - dragStart
        Frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- Respawn fix
Player.CharacterAdded:Connect(function()
    wait(1)
    if speedEnabled then toggleSpeed(true) end
    if noTsunami then toggleNoTsunami(true) end
end)

